# Copy to the VM / local pc env — do not commit real values.
GVL_DEVICE_IP=
# Home Wi-Fi /24 when gvld is on another subnet (multicast scan won't cross).
GVL_DISCOVER_SUBNET=
# Auto-find bulb after DHCP IP change (default on). Set 0/false/off to disable.
GVL_AUTO_DISCOVER=1
GVL_TOKEN=
GVL_TZ=UTC
GVL_LISTEN=:8080
GVL_DATA_DIR=/data
